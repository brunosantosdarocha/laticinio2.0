{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Iniciar sistema (iniciar.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/iniciar.py",
      "console": "integratedTerminal"
    },
    {
      "name": "Desenvolvimento (runserver)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": ["runserver"],
      "django": true,
      "console": "integratedTerminal",
      "env": {"DEBUG": "True"}
    }
  ]
}
