# Copie para ".env" (o iniciar.py já faz isso sozinho na primeira vez).
# NUNCA envie o .env para o GitHub.

# Chave secreta: gere com  python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=troque-por-uma-chave-aleatoria-de-50-caracteres

# True só enquanto estiver programando (mostra erros detalhados)
DEBUG=False

# Endereços que podem acessar o sistema (separe por vírgula). Ex.: leite.meudominio.com.br
ALLOWED_HOSTS=127.0.0.1,localhost

# Endereço do painel técnico do Django (troque por algo difícil de adivinhar)
ADMIN_URL=gestao-interna/

# True para o celular do coletor acessar pelo Wi-Fi (mesma rede)
ACESSO_REDE=False

# True quando estiver na internet com https (VPS + certificado)
USAR_HTTPS=False
# Com domínio próprio e https, informe também:
# CSRF_TRUSTED_ORIGINS=https://leite.meudominio.com.br

# Coleta offline: quantos dias para trás o celular pode enviar lançamentos guardados
COLETA_OFFLINE_DIAS=7
# Quantos dias o coletor fica logado no celular sem precisar entrar de novo
COLETOR_SESSAO_DIAS=30
